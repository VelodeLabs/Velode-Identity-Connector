<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<!-- Oldest Spring Boot line a connected application runs on; the connector also runs on 4.x. -->
		<version>3.5.14</version>
		<relativePath/>
	</parent>
	<groupId>com.velode</groupId>
	<artifactId>identity-spring-boot-starter</artifactId>
	<version>0.1.0</version>
	<name>velode-identity-connector</name>
	<description>Connects a Spring Boot application to Velode Identity without managed credentials</description>
	<url>https://github.com/VelodeLabs/Velode-Identity-Connector</url>
	<scm>
		<url>https://github.com/VelodeLabs/Velode-Identity-Connector</url>
		<connection>scm:git:https://github.com/VelodeLabs/Velode-Identity-Connector.git</connection>
	</scm>
	<distributionManagement>
		<repository>
			<id>github</id>
			<url>https://maven.pkg.github.com/VelodeLabs/Velode-Identity-Connector</url>
		</repository>
	</distributionManagement>
	<properties>
		<java.version>21</java.version>
		<maven.compiler.parameters>true</maven.compiler.parameters>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-autoconfigure</artifactId>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>
		<!-- The application chooses its web stack and where the connection is stored. -->
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-jdbc</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.data</groupId>
			<artifactId>spring-data-redis</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
