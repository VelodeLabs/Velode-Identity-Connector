<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<!-- Oldest Spring Boot line a connected application runs on; the connector also runs on 4.x. -->
		<version>3.5.16</version>
		<relativePath/>
	</parent>
	<groupId>com.velode</groupId>
	<artifactId>identity-spring-boot-starter</artifactId>
	<version>0.4.1</version>
	<name>velode-identity-connector</name>
	<description>Connects a Spring Boot application to Velode Identity without managed credentials</description>
	<url>https://github.com/VelodeLabs/Velode-Identity-Connector</url>
	<organization>
		<name>Velode Labs</name>
		<url>https://github.com/VelodeLabs</url>
	</organization>
	<licenses>
		<license>
			<name>Apache-2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<developers>
		<developer>
			<id>velodelabs</id>
			<name>Velode Labs</name>
			<email>admin@velode.com</email>
			<organization>Velode Labs</organization>
			<organizationUrl>https://github.com/VelodeLabs</organizationUrl>
		</developer>
	</developers>
	<scm>
		<url>https://github.com/VelodeLabs/Velode-Identity-Connector</url>
		<connection>scm:git:https://github.com/VelodeLabs/Velode-Identity-Connector.git</connection>
		<developerConnection>scm:git:git@github.com:VelodeLabs/Velode-Identity-Connector.git</developerConnection>
		<tag>HEAD</tag>
	</scm>
	<issueManagement>
		<system>GitHub</system>
		<url>https://github.com/VelodeLabs/Velode-Identity-Connector/issues</url>
	</issueManagement>
	<distributionManagement>
		<repository>
			<id>github</id>
			<url>https://maven.pkg.github.com/VelodeLabs/Velode-Identity-Connector</url>
		</repository>
	</distributionManagement>
	<properties>
		<java.version>21</java.version>
		<maven.compiler.parameters>true</maven.compiler.parameters>
		<!-- Test-only, through spring-boot-starter-test; GHSA-qv9r-c865-cp47 is fixed in 2.25.5. -->
		<log4j2.version>2.25.5</log4j2.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-autoconfigure</artifactId>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>
		<!-- The application chooses its web stack and where the connection is stored. -->
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-jdbc</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<!-- The Apache License asks every copy of the work to carry the license and notice. -->
			<resource>
				<directory>${project.basedir}</directory>
				<targetPath>META-INF</targetPath>
				<includes>
					<include>LICENSE</include>
					<include>NOTICE</include>
				</includes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifestEntries>
							<Automatic-Module-Name>com.velode.identity.connector</Automatic-Module-Name>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Sources and Javadoc published with every release. -->
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
						<executions>
							<execution>
								<id>attach-sources</id>
								<goals>
									<goal>jar-no-fork</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<configuration>
							<doclint>all,-missing</doclint>
						</configuration>
						<executions>
							<execution>
								<id>attach-javadocs</id>
								<goals>
									<goal>jar</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<!--
			Signs and publishes to Maven Central. The signing key and its passphrase come only from the
			MAVEN_GPG_KEY and MAVEN_GPG_PASSPHRASE environment variables.
		-->
		<profile>
			<id>central</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.8</version>
						<configuration>
							<signer>bc</signer>
							<bestPractices>true</bestPractices>
						</configuration>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>0.12.0</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<autoPublish>true</autoPublish>
							<waitUntil>published</waitUntil>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
